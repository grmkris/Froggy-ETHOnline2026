# Froggy — every variable, with the placeholder that means "not set yet".
#
# A variable still holding its placeholder puts its integration in *stub* mode:
# the app boots, the UI marks it, and every receipt it touches says `stubbed`.
# Copying this file verbatim therefore behaves identically to having no `.env`
# at all, rather than producing a confident client pointed at a nonsense key.

PORT=3001
# Where the browser reaches this server. Also the trusted WebSocket origin: an
# upgrade bypasses CORS entirely, and the browser socket types into a Chrome
# logged into your sites, so this list is the only thing standing between a
# hostile page and a remote-control handle on that browser.
APP_ORIGIN=http://localhost:3000
# Comma-separated additional origins, for a preview deployment or a second port.
EXTRA_ORIGINS=
# Set in production to the built SPA. Empty means Vite is serving the client.
STATIC_DIR=
# The agent's Chrome profile. Persistent, so logins survive a restart — which is
# the product ("the agent shops as you") and also the part to think hard about.
CHROME_PROFILE_DIR=.froggy/chrome-profile
# Browser seats. One worker process per signed-in user, at most this many at
# once (0 is unlimited); past it people wait in line and are seated when a
# seat frees. One seat is held for the demo account, named by its Privy DID,
# so a judge never waits behind testers. A browser nobody is watching or
# driving is released after the idle period; the profile stays on disk.
MAX_BROWSERS=8
RESERVED_BROWSERS=1
BROWSER_IDLE_MS=600000
DEMO_USER_DID=
#
# Unset means the spend ledger lives in memory: correct for one process, lost on
# restart, and reported as `database=stub` in the wallet pane. Set it and the
# same interface is served by Postgres, where a unique index on
# `(user_id, idempotency_key)` stops a retried payment paying twice across
# processes and a rolling cap survives a redeploy. Run `bun run db:migrate`
# first.
#
#   docker run -d --name froggy-pg -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=froggy -p 5434:5432 postgres:17
#
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/froggy

# --- Privy -------------------------------------------------------------------
# Unblocks: the Privy track, and any real wallet at all.
# Dashboard settings this code cannot see: email and Google login on, embedded
# wallets created on login (the agent is granted a signer on that wallet), and
# every origin the app is served from in the allowed-origins list.
PRIVY_APP_ID=REPLACE_ME_PRIVY_APP_ID
PRIVY_APP_SECRET=REPLACE_ME_PRIVY_APP_SECRET
# The app id is public and is baked into the web bundle at build time.
VITE_PRIVY_APP_ID=REPLACE_ME_PRIVY_APP_ID
#
# The agent's authorization key: how Privy knows a signing request is ours.
# All three or none — two of three fails at the first payment instead of at
# boot, and the second is much easier to act on. Sign-in still works without
# them; the agent just cannot be granted a signature on anyone's wallet.
#
# The quorum holds the P-256 *public* key; this is the private half, base64
# PKCS8 with no PEM headers. Create both with:
#   bun run privy:agent-key
PRIVY_AUTHORIZATION_KEY_ID=REPLACE_ME_PRIVY_KEY_QUORUM_ID
PRIVY_AUTHORIZATION_PRIVATE_KEY=REPLACE_ME_PRIVY_AUTHORIZATION_KEY
# The default-deny policy the agent signs under. Its JSON is committed at
# `docs/privy-agent-policy.json`, so what the agent may do is reviewable.
PRIVY_AGENT_POLICY_ID=REPLACE_ME_PRIVY_POLICY_ID

# --- The Graph ---------------------------------------------------------------
# Unblocks: the Graph track. Mocked or static data explicitly does not qualify,
# so a stubbed Graph query qualifies for nothing.
# The key alone. *Which* deployments are queried is pinned in
# `packages/graph/src/registry.ts` rather than configured here, because the set
# of indexes an answer came from is a claim every receipt makes — and a claim
# like that belongs somewhere reviewable, not in an environment variable.
GRAPH_API_KEY=REPLACE_ME_GRAPH_STUDIO_KEY
GRAPH_GATEWAY_URL=https://gateway.thegraph.com/api
# Pay the gateway per query with x402 ($0.01 in USDC on Base) from the
# person's own Privy wallet, signed by the agent under the policy — instead of
# the Studio key. Each query becomes a receipt. Needs the gateway's host on
# the person's directory and USDC in the wallet.
GRAPH_PAY_PER_QUERY=false

# --- Hedera x402 -------------------------------------------------------------
# Unblocks: the Hedera track, which requires a *hosted* x402 service and an
# agent that completes one real paid request against it. Both halves are here.
# An ECDSA account from portal.hedera.com; both values or neither.
HEDERA_ACCOUNT_ID=0.0.0
HEDERA_PRIVATE_KEY=0xREPLACE_ME
# The account our own paid endpoint is paid *to*. Defaults to the pocket above,
# which works but demonstrates nothing: a settlement is only checkable on a
# mirror node if the HBAR actually moves between two accounts.
HEDERA_PAY_TO=
HEDERA_FACILITATOR_URL=https://api.testnet.blocky402.com
# A Hedera Consensus Service topic that gets one public note per settlement,
# sold or bought, readable on any mirror node. Leave empty and the server
# creates one at first use and prints its id; pin it here to keep the trail
# across restarts.
HEDERA_HCS_TOPIC_ID=
# Where the HBAR/USD rate comes from. The network's own published rate, not a
# market feed: the question a cap asks is "what does Hedera say this is worth".
# Mainnet even on a testnet run, because the testnet rate is not a real price.
HEDERA_MIRROR_NODE_URL=https://mainnet-public.mirrornode.hedera.com

# --- The model ---------------------------------------------------------------
# Unblocks: an agent that can reason. Without a key the loop still runs — it
# follows a fixed script and says so — but it cannot decide anything.
#
# An OpenAI-compatible endpoint is used when all three of these are set; this
# deployment runs on Alibaba's Token Plan endpoint with qwen3.8-max. That is
# *not* DashScope proper: dashscope-intl.aliyuncs.com rejects this key with
# `invalid_api_key`, and `qwen3-max` does not exist there — both were wrong
# here until 5 Sep, while `/health` reported the model as live. The base URL
# and model are pre-filled so only the key is missing; a copied file therefore
# still runs the scripted model.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
OPENAI_COMPATIBLE_MODEL=qwen3.8-max
# Anthropic, used only when the compatible endpoint above is not configured.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- Telegram ----------------------------------------------------------------
# Unblocks: the pager. A bot from @BotFather; the webhook is
# `POST <APP_ORIGIN>/telegram/webhook`, registered with the secret below:
#   curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#     -d url="$APP_ORIGIN/telegram/webhook" -d secret_token="$TELEGRAM_WEBHOOK_SECRET_TOKEN"
# Token and secret together, or neither: a bot that answers unverified
# webhooks is a bot anyone on the internet can freeze wallets through. The
# username is for the pairing deep link only.
TELEGRAM_BOT_TOKEN=REPLACE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Optional ----------------------------------------------------------------
# Point at a specific Chrome binary. A path that does not exist is reported as
# "no Chrome" rather than silently falling back, so a typo stays visible.
# FROGGY_CHROME=/usr/bin/chromium
