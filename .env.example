# Froggy — every variable, with the placeholder that means "not set yet".
#
# A variable still holding its placeholder puts its integration in *stub* mode:
# the app boots, the UI marks it, and every receipt it touches says `stubbed`.
# Copying this file verbatim therefore behaves identically to having no `.env`
# at all, rather than producing a confident client pointed at a nonsense key.

PORT=3001
# Where the browser reaches this server. Also the trusted WebSocket origin: an
# upgrade bypasses CORS entirely, and the browser socket types into a Chrome
# logged into your sites, so this list is the only thing standing between a
# hostile page and a remote-control handle on that browser.
APP_ORIGIN=http://localhost:3000
# Comma-separated additional origins, for a preview deployment or a second port.
EXTRA_ORIGINS=
# Set in production to the built SPA. Empty means Vite is serving the client.
STATIC_DIR=
# The agent's Chrome profile. Persistent, so logins survive a restart — which is
# the product ("the agent shops as you") and also the part to think hard about.
CHROME_PROFILE_DIR=.froggy/chrome-profile
# Concurrent Chromes across all signed-in users. 0 is unlimited, which is what
# this build ships. Two Chromes are roughly a gigabyte, so a link that gets
# shared widely will exhaust the box; this is the dial for that.
MAX_BROWSERS=0
#
# Unset means the spend ledger lives in memory: correct for one process, lost on
# restart, and reported as `database=stub` in the wallet pane. Set it and the
# same interface is served by Postgres, where a unique index on
# `(user_id, idempotency_key)` stops a retried payment paying twice across
# processes and a rolling cap survives a redeploy. Run `bun run db:migrate`
# first.
#
#   docker run -d --name froggy-pg -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=froggy -p 5434:5432 postgres:17
#
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/froggy

# --- Privy -------------------------------------------------------------------
# Unblocks: the Privy track, and any real wallet at all.
# Two dashboard toggles are invisible from here and were a documented trap in
# humanhook: guest accounts must be ON, and smart wallets enabled for Base
# Sepolia, or `user.smartWallet` never fills.
PRIVY_APP_ID=REPLACE_ME_PRIVY_APP_ID
PRIVY_APP_SECRET=REPLACE_ME_PRIVY_APP_SECRET
# The app id is public and is baked into the web bundle at build time.
VITE_PRIVY_APP_ID=REPLACE_ME_PRIVY_APP_ID

# --- The Graph ---------------------------------------------------------------
# Unblocks: the Graph track. Mocked or static data explicitly does not qualify,
# so a stubbed Graph query qualifies for nothing.
GRAPH_API_KEY=REPLACE_ME_GRAPH_STUDIO_KEY
GRAPH_SUBGRAPH_ID=REPLACE_ME_SUBGRAPH_ID
GRAPH_GATEWAY_URL=https://gateway.thegraph.com/api

# --- Hedera x402 -------------------------------------------------------------
# Unblocks: the Hedera track, which requires a *hosted* x402 service and an
# agent that completes one real paid request against it. Both halves are here.
# An ECDSA account from portal.hedera.com; both values or neither.
HEDERA_ACCOUNT_ID=0.0.0
HEDERA_PRIVATE_KEY=0xREPLACE_ME
HEDERA_FACILITATOR_URL=https://api.testnet.blocky402.com

# --- The model ---------------------------------------------------------------
# Unblocks: an agent that can reason. Without either of these the loop still
# runs — it follows a fixed script and says so — but it cannot decide anything.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Any OpenAI-compatible endpoint, used when Anthropic's key is absent.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# --- Optional ----------------------------------------------------------------
# Point at a specific Chrome binary. A path that does not exist is reported as
# "no Chrome" rather than silently falling back, so a typo stays visible.
# FROGGY_CHROME=/usr/bin/chromium
