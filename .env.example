# Froggy — every variable, with the placeholder that means "not set yet".
#
# A variable still holding its placeholder puts its integration in *stub* mode:
# the app boots, the UI marks it, and every receipt it touches says `stubbed`.
# Copying this file verbatim therefore behaves identically to having no `.env`
# at all, rather than producing a confident client pointed at a nonsense key.

PORT=3001
# Where the browser reaches this server. Also the trusted WebSocket origin: an
# upgrade bypasses CORS entirely, and the browser socket types into a Chrome
# logged into your sites, so this list is the only thing standing between a
# hostile page and a remote-control handle on that browser.
APP_ORIGIN=http://localhost:3000
# Comma-separated additional origins, for a preview deployment or a second port.
EXTRA_ORIGINS=
# Set in production to the built SPA. Empty means Vite is serving the client.
STATIC_DIR=
# Browser seats. One hosted browser per signed-in user, at most this many at
# once (0 is unlimited); past it people wait in line and are seated when a
# seat frees. One seat is held for the demo account, named by its Privy DID,
# so a judge never waits behind testers. A browser nobody is watching or
# driving is released after the idle period — which also stops it billing;
# the profile stays at the provider, so the logins survive.
MAX_BROWSERS=8
RESERVED_BROWSERS=1
BROWSER_IDLE_MS=600000
DEMO_USER_DID=
#
# Unset means the spend ledger lives in memory: correct for one process, lost on
# restart, and reported as `database=stub` in the wallet pane. Set it and the
# same interface is served by Postgres, where a unique index on
# `(user_id, idempotency_key)` stops a retried payment paying twice across
# processes and a rolling cap survives a redeploy. Run `bun run db:migrate`
# first.
#
#   docker run -d --name froggy-pg -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=froggy -p 5434:5432 postgres:17
#
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/froggy

# --- Privy -------------------------------------------------------------------
# Unblocks: the Privy track, and any real wallet at all.
# Dashboard settings this code cannot see: email and Google login on, embedded
# wallets created on login (the agent is granted a signer on that wallet), and
# every origin the app is served from in the allowed-origins list.
PRIVY_APP_ID=REPLACE_ME_PRIVY_APP_ID
PRIVY_APP_SECRET=REPLACE_ME_PRIVY_APP_SECRET
# The app id is public and is baked into the web bundle at build time.
VITE_PRIVY_APP_ID=REPLACE_ME_PRIVY_APP_ID
#
# The agent's authorization key: how Privy knows a signing request is ours.
# All three or none — two of three fails at the first payment instead of at
# boot, and the second is much easier to act on. Sign-in still works without
# them; the agent just cannot be granted a signature on anyone's wallet.
#
# The quorum holds the P-256 *public* key; this is the private half, base64
# PKCS8 with no PEM headers. Create both with:
#   bun run privy:agent-key
PRIVY_AUTHORIZATION_KEY_ID=REPLACE_ME_PRIVY_KEY_QUORUM_ID
PRIVY_AUTHORIZATION_PRIVATE_KEY=REPLACE_ME_PRIVY_AUTHORIZATION_KEY
# The default-deny policy the agent signs under. Its JSON is committed at
# `docs/privy-agent-policy.json`, so what the agent may do is reviewable.
PRIVY_AGENT_POLICY_ID=REPLACE_ME_PRIVY_POLICY_ID

# Each person's own Privy policy is pinned to these. Without both, no per-person
# policy is minted and everybody stays on PRIVY_AGENT_POLICY_ID above — which is
# the honest fallback, not a failure: a policy with nothing to pin would carry no
# rules, and a policy with no rules is a wallet the agent cannot sign for at all.
# The payee is the x402 recipient a person's agent may pay; the treasury comes
# from TREASURY_EVM_ADDRESS.
PRIVY_PERSON_SERVICE_PAYEE=0xREPLACE_ME_SERVICE_PAYEE
# The Earn vault a sweep may enter. Unset, no Earn rule is written at all, which
# is deliberate: a rule naming an empty vault is a leash on a bricked-up door.
PRIVY_EARN_VAULT_ID=REPLACE_ME_PRIVY_EARN_VAULT_ID

# Whether a person's policy is owned by them rather than by our app secret.
# Owned by them is the design: the rules holding their agent stop being ours to
# widen, and only their own key -- which exists in their browser and nowhere
# else -- can change them. It is a variable so it can be turned off in one place
# if Privy will not let their key edit what our secret cannot, in which case
# Change and Extend would be buttons nobody can press.
PRIVY_PERSON_OWNED_POLICIES=false

# --- The Graph ---------------------------------------------------------------
# Unblocks: the Graph track. Mocked or static data explicitly does not qualify,
# so a stubbed Graph query qualifies for nothing.
# The key alone. *Which* deployments are queried is pinned in
# `packages/graph/src/registry.ts` rather than configured here, because the set
# of indexes an answer came from is a claim every receipt makes — and a claim
# like that belongs somewhere reviewable, not in an environment variable.
GRAPH_API_KEY=REPLACE_ME_GRAPH_STUDIO_KEY
GRAPH_GATEWAY_URL=https://gateway.thegraph.com/api
# Pay the gateway per query with x402 ($0.01 in USDC on Base) from the
# person's own Privy wallet, signed by the agent under the policy — instead of
# the Studio key. Each query becomes a receipt. Needs the gateway's host on
# the person's directory and USDC in the wallet.
GRAPH_PAY_PER_QUERY=false

# --- Hedera x402 -------------------------------------------------------------
# Unblocks: the Hedera track, which requires a *hosted* x402 service and an
# agent that completes one real paid request against it. Both halves are here.
# An ECDSA account from portal.hedera.com; both values or neither.
HEDERA_ACCOUNT_ID=0.0.0
HEDERA_PRIVATE_KEY=0xREPLACE_ME
# The account our own paid endpoint is paid *to*. Defaults to the pocket above,
# which works but demonstrates nothing: a settlement is only checkable on a
# mirror node if the HBAR actually moves between two accounts.
HEDERA_PAY_TO=
# Which Hedera this deployment pays and sells on: hedera:testnet or
# hedera:mainnet. Mainnet is real money; the accounts above must live there.
HEDERA_NETWORK=hedera:testnet
# 32 random bytes, base64 (`openssl rand -base64 32`). Seals each person's own
# Hedera key at rest. Unset: nobody gets an account of their own and every
# Hedera payment comes from the host account above.
HEDERA_KEK=REPLACE_ME_HEDERA_KEK
# Follows HEDERA_NETWORK when left empty: api.testnet.blocky402.com or
# api.blocky402.com. Set it only to point at a self-hosted facilitator.
HEDERA_FACILITATOR_URL=
# A Hedera Consensus Service topic that gets one public note per settlement,
# sold or bought, readable on any mirror node. Leave empty and the server
# creates one at first use and prints its id; pin it here to keep the trail
# across restarts.
HEDERA_HCS_TOPIC_ID=
# Where the HBAR/USD rate comes from. The network's own published rate, not a
# market feed: the question a cap asks is "what does Hedera say this is worth".
# Mainnet even on a testnet run, because the testnet rate is not a real price.
HEDERA_MIRROR_NODE_URL=https://mainnet-public.mirrornode.hedera.com

# --- The model ---------------------------------------------------------------
# Unblocks: an agent that can reason. Without a key the loop still runs — it
# follows a fixed script and says so — but it cannot decide anything.
#
# An OpenAI-compatible endpoint is used when all three of these are set; this
# deployment runs on Alibaba's Token Plan endpoint with qwen3.8-max. That is
# *not* DashScope proper: dashscope-intl.aliyuncs.com rejects this key with
# `invalid_api_key`, and `qwen3-max` does not exist there — both were wrong
# here until 5 Sep, while `/health` reported the model as live. The base URL
# and model are pre-filled so only the key is missing; a copied file therefore
# still runs the scripted model.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
OPENAI_COMPATIBLE_MODEL=qwen3.8-max
# Anthropic, used only when the compatible endpoint above is not configured.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- Telegram ----------------------------------------------------------------
# Unblocks: the pager. A bot from @BotFather; the webhook is
# `POST <APP_ORIGIN>/telegram/webhook`, registered with the secret below:
#   curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#     -d url="$APP_ORIGIN/telegram/webhook" -d secret_token="$TELEGRAM_WEBHOOK_SECRET_TOKEN"
# Token and secret together, or neither: a bot that answers unverified
# webhooks is a bot anyone on the internet can freeze wallets through. The
# username is for the pairing deep link only.
TELEGRAM_BOT_TOKEN=REPLACE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- The conversion ---------------------------------------------------------
# Unblocks: the Privy headline flow. When a Hedera payment needs more HBAR
# than the person holds, the server sends their USDC on Base from their Privy
# wallet to this address, signed by the agent under the committed policy's
# rule (b), and funds their Hedera account against what lands here. Nobody
# types "top up": it happens inside the payment, as a spend of its own. The
# policy names the same address, so a transfer anywhere else is refused by
# Privy before any bytes exist. Not a secret; the placeholder means "no
# conversion until somebody decides where the money goes".
TREASURY_EVM_ADDRESS=0xREPLACE_ME_TREASURY
# The treasury as a Privy app wallet the agent key may sign for (its policy
# allows only the Graph x402 payment). With both set, Froggy pays The Graph
# upstream itself when GRAPH_PAY_PER_QUERY is on.
TREASURY_WALLET_ID=REPLACE_ME_TREASURY_WALLET_ID
# People's Hedera keys held by Privy: the policy (chain_type cosmos, one ALLOW *
# rule) their cosmos-type wallets are created under, with the agent key as the
# signer. Unset: Froggy seals the keys itself under HEDERA_KEK.
PRIVY_HEDERA_POLICY_ID=REPLACE_ME_PRIVY_HEDERA_POLICY_ID
# Where signed Base Sepolia transactions are broadcast. Any JSON-RPC endpoint.
# Which Base the person's USDC lives on and conversions move on: eip155:8453
# (mainnet) or eip155:84532 (Sepolia). The RPC must answer for the same chain;
# boot refuses otherwise. EVM_RPC_URL defaults to the public node for the
# network; BASE_SEPOLIA_RPC_URL is the older name and still honoured.
EVM_NETWORK=eip155:84532
EVM_RPC_URL=
# What a person's Hedera balance starts at before any conversion, in dollars.
# Testnet lunch money, credited once per person; a conversion under rule (b)
# adds to it and every Hedera payment draws it down.
POCKET_STARTING_USD=0.50
# Privy DIDs (comma-separated) that start with TEAM_STARTING_USD instead of the
# figure above: the team and the demo account, so they can test before paying.
# On mainnet POCKET_STARTING_USD is 0 and a person's Hedera account opens with
# their first conversion.
STARTING_CREDIT_DIDS=
TEAM_STARTING_USD=1
# Whether mandates carry caps, an expiry and an approval threshold. Off: a
# mandate is allowlists only, and restraint is provenance plus Privy's policy.
# On: the seven-rule mandate ($2 a payment, $10 a day, ask above $1, a day's
# expiry), which the browser tests use to exercise approvals.
SPENDING_LIMITS=false
# The model budget: turns and steps one person may burn per UTC day. The
# mandate caps the money; this caps the words, so a shared link cannot drain
# the model key overnight. The demo account (DEMO_USER_DID) is exempt.
MODEL_RUNS_PER_DAY=40
MODEL_STEPS_PER_DAY=400

# Content Security Policy on the page: `enforce` (default) or `report`, which
# sends the same policy as report-only so a too-strict directive can be seen
# in the browser console without breaking sign-in. Framing is refused either way.
CSP_MODE=enforce

# Optional marketplace suppliers. Empty: unavailable on live Hedera, demo fixtures with stub Hedera.
# Server-only X app bearer; never reuse a personal xurl token store.
X_API_BEARER_TOKEN=
# Comma-separated supported-host=verified-Base-payee pairs. Review the matching treasury policy first.
# Verified examples and unsigned policy rules: docs/evidence/MARKETPLACE.md
SERVICE_SUPPLIER_PAYEES=

# Solana x402 purchases use the person's own Privy Solana wallet.
# Mainnet: solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
# A fresh checkout stays on devnet. Fund the displayed USDC account before paying.
SOLANA_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
SOLANA_RPC_URL=

# Trading research. Keys and credential-bearing RPC URLs stay on the server.
BIRDEYE_API_KEY=REPLACE_ME_BIRDEYE_KEY
UNISWAP_API_KEY=REPLACE_ME_UNISWAP_KEY
# JSON object: configured CAIP-2 network -> Quicknode HTTPS endpoint.
# Example shape: {"eip155:8453":"https://YOUR_ENDPOINT.quiknode.pro/YOUR_TOKEN/"}
TRADING_RPC_ENDPOINTS={}
UNISWAP_CHAINS='[{"network":"eip155:8453","routerVersion":"2.1.1"},{"network":"eip155:84532","routerVersion":"2.1.1"},{"network":"eip155:1","routerVersion":"2.1.1"},{"network":"eip155:11155111","routerVersion":"2.1.1"},{"network":"eip155:4663","routerVersion":"2.1.1"}]'
# Integer USD micros per operation; missing prices disable live paid calls.
# Keys: market_search, token_inspect, rpc_read, quote_action, watch_launches.
# watch_launches is one fixed bundle price covering up to 120 provider polls; review quotas/costs.
TRADING_PRICES_USD_MICROS={}

# Independent EVM transaction simulation; live execution needs all three plus Uniswap/RPC configuration.
TENDERLY_ACCESS_KEY=REPLACE_ME_TENDERLY_ACCESS_KEY
TENDERLY_ACCOUNT=
TENDERLY_PROJECT=
TRADING_CONFIRMATIONS=2

# Jupiter Swap v2, with an independent Solana mainnet endpoint in TRADING_RPC_ENDPOINTS.
JUPITER_API_KEY=REPLACE_ME_JUPITER_API_KEY
ENSO_API_KEY=REPLACE_ME_ENSO_API_KEY

# Native Pump trading stays unavailable until explicitly enabled by the operator.
PUMP_EXECUTION_ENABLED=false

# Browser Use is the browser. There is no local Chrome and no second provider:
# without a key the pane says so and refuses to open one, and every receipt it
# would have touched is marked stubbed. Key from
# https://cloud.browser-use.com/settings?tab=api-keys
BROWSER_USE_API_KEY=REPLACE_ME_BROWSER_USE_KEY
# Country to proxy the hosted browser through. `none` runs without a proxy —
# cheaper (the managed residential proxy bills per GB) and usually fine.
BROWSER_COUNTRY=us
# Froggy's own model, priced for the browse-task allowance. Both must be above
# zero before a paid browse task can be sold with a live model. Configure a
# *ceiling* on what a token can cost: too high only ends a task early, too low
# spends more than the task was paid. Production uses the published flat list
# rate for qwen3.8-max (2.00/6.00), which a prepaid plan cannot exceed.
BROWSER_MODEL_INPUT_USD_PER_MILLION=0
BROWSER_MODEL_OUTPUT_USD_PER_MILLION=0

# Native Pons execution stays disabled until the operator validates its live dependencies.
PONS_EXECUTION_ENABLED=false
