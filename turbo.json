{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", "cache/**"]
    },
    "dev": {
      "cache": false,
      "env": ["LEDGER_DIR", "PORT", "VITE_WS_URL"],
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@froggy/wallet#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/privy-agent-policy.json",
        "$TURBO_ROOT$/docs/privy-treasury-relay-rule.json"
      ],
      "outputs": []
    }
  }
}
