{
  "name": "froggy",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "demo": "bun tools/demo.ts",
    "dev:web": "turbo run dev --filter=@froggy/web",
    "dev:server": "turbo run dev --filter=@froggy/server",
    "e2e": "playwright test",
    "e2e:install": "bunx --bun playwright install chromium",
    "build": "turbo run build",
    "check": "bun run format:check && bun run lint:types && bun run typecheck && bun run graph && bun run agents:check && bun run names:check && bun run test && bun run knip",
    "check:fast": "bun run format:check && bun run lint && bun run typecheck",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint .",
    "lint:types": "oxlint --type-aware --report-unused-disable-directives .",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tools/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "test": "turbo run test",
    "knip": "knip",
    "graph": "bun tools/check-graph.ts",
    "agents:check": "bun tools/check-agent-files.ts",
    "names:check": "bun tools/check-names.ts",
    "hooks:install": "lefthook install",
    "fix": "ultracite fix",
    "db:generate": "bun run --cwd packages/database db:generate",
    "db:migrate": "bun apps/server/src/migrate.ts",
    "privy:agent-key": "bun tools/privy-agent-key.ts",
    "privy:policy": "bun tools/privy-policy.ts"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@oxlint/plugins": "1.81.0",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.1",
    "effect": "4.0.0-rc.112",
    "knip": "6.34.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "railway": "3.10.0",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "ultracite": "7.10.8"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
